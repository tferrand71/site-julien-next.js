// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HeroContent {
  id          Int    @id @default(1)
  title_fr    String @default("CHEF D'ORCHESTRE")
  title_en    String @default("CONDUCTOR")
  title_de    String @default("DIRIGENT")
  title_es    String @default("DIRECTOR DE ORQUESTA")
  subtitle_fr String @default("Tromboniste & Pédagogue")
  subtitle_en String @default("Trombonist & Educator")
  subtitle_de String @default("Posaunist & Pädagoge")
  subtitle_es String @default("Trombonista y Educador")
}

model Event {
  id          String   @id @default(uuid())
  startDate   DateTime
  endDate     DateTime?
  location    String?
  isUpcoming  Boolean  @default(true)
  title_fr    String
  title_en    String
  title_de    String
  title_es    String
  desc_fr     String
  desc_en     String
  desc_de     String
  desc_es     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Biography {
  id          Int    @id @default(1)
  content_fr  String @default("")
  content_en  String @default("")
  content_de  String @default("")
  content_es  String @default("")
  cvUrl       String?
  bioUrl      String?
}

model VideoConfig {
  id        String  @id @default(uuid())
  youtubeId String  @unique
  isHidden  Boolean @default(false)
  order     Int     @default(0)
}

model Repertoire {
  id        String   @id @default(uuid())
  category  String
  composer  String
  piece     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(uuid())
  status    String   @default("CURRENT")
  title_fr  String
  title_en  String
  title_de  String
  title_es  String
  desc_fr   String
  desc_en   String
  desc_de   String
  desc_es   String
  imageData String?  // Stores base64 string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PastSeason {
  id        String   @id @default(uuid())
  year      String
  title_fr  String
  title_en  String
  title_de  String
  title_es  String
  desc_fr   String
  desc_en   String
  desc_de   String
  desc_es   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
